{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["teams", "workerImage", "argocdNamespace", "gitops"],
  "properties": {
    "teams": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z]([a-z0-9-]{0,18}[a-z0-9])?$" }
    },
    "budgets": {
      "description": "Set by make up from platform/budgets.txt: each team's monthly token budget",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z]([a-z0-9-]{0,18}[a-z0-9])?$" },
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "workerImage": { "type": "string", "pattern": "@sha256:[a-f0-9]{64}$" },
    "images": {
      "description": "Set by make deploy: the coding image and each skill's image, by digest",
      "type": "object",
      "additionalProperties": false,
      "required": ["coding", "skills"],
      "properties": {
        "coding": { "type": "string", "pattern": "^$|^[^\\s@]+@sha256:[a-f0-9]{64}$" },
        "skills": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^[^\\s@]+@sha256:[a-f0-9]{64}$" }
        }
      }
    },
    "minter": {
      "description": "Set by make up: the minter's image, by digest, and its source files (name without .ts to text)",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": { "type": "string", "pattern": "^$|^[^\\s@]+@sha256:[a-f0-9]{64}$" },
        "source": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "argocdNamespace": { "type": "string", "minLength": 1 },
    "gitops": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repoURL", "revision"],
      "properties": {
        "repoURL": { "type": "string", "pattern": "^https://" },
        "revision": { "type": "string", "minLength": 1 }
      }
    }
  }
}
