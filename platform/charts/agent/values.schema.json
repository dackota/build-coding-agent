{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "A team agent's values file",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "team", "owner", "runtime", "model", "tokenCap"],
  "properties": {
    "name": {
      "description": "The agent's name; the same as its folder under deployments/<team>/. The team base's subagent template names are taken",
      "type": "string",
      "pattern": "^[a-z]([a-z0-9-]{0,38}[a-z0-9])?$",
      "not": { "enum": ["explorer-template", "executor-template", "reviewer-template"] }
    },
    "team": {
      "description": "The team that owns the agent, one of platform/teams.txt; the agent runs in team-<team>",
      "type": "string",
      "pattern": "^[a-z]([a-z0-9-]{0,18}[a-z0-9])?$"
    },
    "owner": {
      "description": "Who to ask about this agent (a GitHub handle or an email)",
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "maxLength": 300
    },
    "runtime": {
      "description": "stock: kagent's built-in runtime. coding: the platform's coding agent (file tools, bash with approvals, subagents, /implement). byo comes in a later release",
      "type": "string",
      "enum": ["stock", "coding", "byo"]
    },
    "model": {
      "description": "A platform model name",
      "type": "string",
      "enum": ["glm-5.3-flash"]
    },
    "systemPrompt": {
      "description": "Required for stock and coding",
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "tokenCap": {
      "description": "The agent's monthly token cap, inside its team's cap",
      "type": "integer",
      "minimum": 1,
      "maximum": 50000000
    },
    "subagents": {
      "description": "Subagents by name, from the team base's templates",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["explorer", "executor", "reviewer"] }
    },
    "tools": {
      "description": "Catalog tools by name. A write tool (github-write, demo-delete-branch) always pauses for a human's approval; a read tool may ask for it with requireApproval: true",
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/definitions/toolName" },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "$ref": "#/definitions/toolName" },
              "requireApproval": { "type": "boolean" }
            },
            "if": { "properties": { "name": { "enum": ["github-write", "demo-delete-branch"] } } },
            "then": { "properties": { "requireApproval": { "const": true } } }
          }
        ]
      }
    },
    "skills": {
      "description": "Skills by name, from platform/skills/; make deploy pins each skill's image",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["docs-style"] }
    },
    "platform": {
      "description": "Set by the platform (the ApplicationSet), not by a values file: the pinned skill images",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skillImages": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^[^\\s@]+@sha256:[a-f0-9]{64}$" }
        }
      }
    }
  },
  "definitions": {
    "toolName": { "type": "string", "enum": ["github-read", "github-write", "demo-delete-branch"] }
  },
  "allOf": [
    {
      "if": { "required": ["runtime"], "properties": { "runtime": { "enum": ["stock", "coding"] } } },
      "then": { "required": ["systemPrompt"] }
    }
  ]
}
