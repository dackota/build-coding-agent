# The one place the platform scripts read versions and digests from. Sourced by
# platform/lib.sh; docs/pinned-versions.md says where each value came from.
# Change a pin only on purpose, and update docs/pinned-versions.md with it.

# Tools on PATH. preflight.sh refuses another kind version, and a Helm major other
# than these.
KIND_VERSION=v0.32.0
HELM_MAJORS="3 4"

# Cluster node image (Kubernetes 1.37, the version kagent 1.x asks for).
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5

# Local registry.
REGISTRY_IMAGE=registry:2@sha256:a3d8aaa63ed8681a604f1dea0aa03f100d5895b6a58ace528858a7b332415373
REGISTRY_PORT=5001

# kagent: CLI, charts, and the images its values file pins.
KAGENT_VERSION=1.0.0-alpha17
KAGENT_CLI_URL=https://github.com/kagent-dev/kagent/releases/download/v$KAGENT_VERSION
KAGENT_CLI_SHA256_DARWIN_ARM64=2b19bb110b5c322b1100d36c6c99f77b9a2fd3454db6a768efbba579bb13d0f1
KAGENT_CLI_SHA256_DARWIN_AMD64=bc43a102bcf68aff76bd862e4dc452f7209552e9ef4c3143f672eca68ee2c6c5
KAGENT_CLI_SHA256_LINUX_ARM64=9ecb393fa35e0c5aa96c03acd3b79d7390cde0e4d8668b38d7c4b8c8f4ed1fe6
KAGENT_CLI_SHA256_LINUX_AMD64=01fb21bc46130dcffac5b5a720d903122563a4d926f4455cd8234c6112d338a3
KAGENT_CHART_REPO=oci://ghcr.io/kagent-dev/kagent/helm
KAGENT_CHART_DIGEST=sha256:aa04bc3c52d31d1860f3229ae5bf208f2c2050a933faf1f506e49fe65e3fbae5
KAGENT_CRDS_CHART_DIGEST=sha256:c0881dac83bc2a850e70c79d0b0f58f4ac438f8e0c7d8252ce39b5129505619e
KAGENT_CONTROLLER_DIGEST=sha256:d0c5c21998f7492fe42636c9216accc7f263ee3087729989d9b3cb78e427c5f5
KAGENT_UI_DIGEST=sha256:68dc2ec374a5250a545b85850b6d284c318e3472c73de6e419e534cdcf5b79a1

# Agent Substrate: the version kagent v1.0.0-alpha17 names in go/go.mod.
SUBSTRATE_VERSION=0.6.0-alpha3
SUBSTRATE_CHART_REPO=oci://ghcr.io/kagent-dev/substrate/helm
SUBSTRATE_CHART_DIGEST=sha256:8018556e64337dc89da55fb174924a718e0ecd4542e236ffbb61a6e27c72a5e4
SUBSTRATE_CRDS_CHART_DIGEST=sha256:f1ddcea3c47f63d08a353e3dbb5ad7bcb94b638394978d64188b846beee90809
SUBSTRATE_PODCERT_CHART_DIGEST=sha256:e48412f8a88165499e11f590e71920df0437939f284134b5bc0a3cf151d05352
SUBSTRATE_WORKER_IMAGE=ghcr.io/kagent-dev/substrate/ateworker-gvisor:v0.6.0-alpha3@sha256:56e6231c3ed48d54afd3068b6313a1545df1277e0ac1faa6090085cc480d573e
# The development PostgreSQL kagent install deploys (the alpha17 CLI's default).
POSTGRES_IMAGE=postgres:18-alpine@sha256:9a8afca54e7861fd90fab5fdf4c42477a6b1cb7d293595148e674e0a3181de15

# agentgateway and the Gateway API CRDs it needs.
AGW_VERSION=v1.6.0
AGW_CHART_REPO=oci://cr.agentgateway.dev/charts
AGW_CHART_DIGEST=sha256:d3edf2b33cbf2e9d59406c207b8d3554597799707b8803b5f62e698fe5376e28
AGW_CRDS_CHART_DIGEST=sha256:dd7f965d43e54dffa9c95af089b6f762397a23c963a159ad6d4992f6c582292a
GATEWAY_API_VERSION=v1.6.0
GATEWAY_CRDS_URL=https://github.com/kubernetes-sigs/gateway-api/releases/download/$GATEWAY_API_VERSION/standard-install.yaml
GATEWAY_CRDS_FILE_SHA256=a557172e8348f758479e9ee4000bbbb4b4aa48302a6b73461823ea5349bad56d

# The demo MCP server (platform/demo-mcp.yaml) runs on the agent image's node base, by the
# same index digest as agent/Dockerfile's FROM.
NODE_IMAGE=node:24-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205

# The image make smoke pushes to the local registry.
SMOKE_IMAGE=busybox:1.37.0@sha256:bdf57e528e45e4433820e045b29b4597825a1c9e38353532d90a01445013f82e
