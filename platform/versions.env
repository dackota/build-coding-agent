# The one place the platform scripts read versions and digests from. Sourced by
# platform/lib.sh; docs/pinned-versions.md says where each value came from.
# Change a pin only on purpose, and update docs/pinned-versions.md with it.

# Tools on PATH. preflight.sh refuses another kind version, and a Helm major other
# than these.
KIND_VERSION=v0.32.0
HELM_MAJORS="3 4"

# Cluster node image (Kubernetes 1.37, the version kagent 1.x asks for).
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5

# Local registry.
REGISTRY_IMAGE=registry:2@sha256:a3d8aaa63ed8681a604f1dea0aa03f100d5895b6a58ace528858a7b332415373
REGISTRY_PORT=5001

# kagent: CLI, charts, and the images its values file pins.
KAGENT_VERSION=1.0.0-rc2
KAGENT_CLI_URL=https://github.com/kagent-dev/kagent/releases/download/v$KAGENT_VERSION
KAGENT_CLI_SHA256_DARWIN_ARM64=58ce05822d113da6527b4fe03e5308b155764e81fe8e6f0a82fea5ab01c059a1
KAGENT_CLI_SHA256_DARWIN_AMD64=eda2e06ed53c63fce5be4f998ff3ccde6fbbcb1db6600341d11e3291897dbf91
KAGENT_CLI_SHA256_LINUX_ARM64=136f4a57ee2252dd2f6dbe042b9857b0ac471fafea8aad006dfe92e928a0ce38
KAGENT_CLI_SHA256_LINUX_AMD64=bc6f2104204a36ccfe16ffc135b82c63c741f4bf3d065447d929b0e0d567eef4
KAGENT_CHART_REPO=oci://ghcr.io/kagent-dev/kagent/helm
KAGENT_CHART_DIGEST=sha256:d8707ae2e9d0f6d2db10a9f2ef0bdbe0e6eb3f8bf5913d820da6b21d58e1ad72
KAGENT_CRDS_CHART_DIGEST=sha256:6d0a285a230ae08e707eee5faef16dac9a059b120685b64ad38954ac2352bebc
KAGENT_CONTROLLER_DIGEST=sha256:1420365cc2dd8f4d37000ddac462b03df38b363f3118d715cb6631c39243f349
KAGENT_UI_DIGEST=sha256:710fe7f2c306ae4e5c010a44b9e44ae4c8f286d31d4a6d1a6d427bb02c40d3e1

# Agent Substrate: the version kagent v1.0.0-rc2 names in go/go.mod.
SUBSTRATE_VERSION=1.0.0-rc2
SUBSTRATE_CHART_REPO=oci://ghcr.io/kagent-dev/substrate/helm
SUBSTRATE_CHART_DIGEST=sha256:c02c1df871f1a41d36c90881508f38be36170eb8cc48a163a3c7ec1508a14fd6
SUBSTRATE_CRDS_CHART_DIGEST=sha256:ef8c8029a32db8cc21b56f60129a8bc594b6532a208bff6ec3a8016dc5a08a2d
SUBSTRATE_PODCERT_CHART_DIGEST=sha256:730a0b0181fc24cca7feb09154fc085e7001a9dcde2e480a0e997f6ff44b8d70
SUBSTRATE_WORKER_IMAGE=ghcr.io/kagent-dev/substrate/ateworker-gvisor:v1.0.0-rc2@sha256:921de912cd9080bc13e296e5a4f758e59353fdd399d0ae97f32a471c15ccbce9
# The development PostgreSQL kagent install deploys (the rc2 CLI's default).
POSTGRES_IMAGE=postgres:18-alpine@sha256:9a8afca54e7861fd90fab5fdf4c42477a6b1cb7d293595148e674e0a3181de15

# Argo CD (deploys the team agents from deployments/): chart and the two images it runs.
ARGOCD_CHART_REPO=oci://ghcr.io/argoproj/argo-helm
ARGOCD_CHART_VERSION=10.11.1
ARGOCD_CHART_DIGEST=sha256:2ac5224a5c201789f96aa9e085673d80732591d1b3e815a8a825a4db6d1d7c88
ARGOCD_IMAGE_TAG=v3.5.6@sha256:8e5cc5bb008df8a09dba439462e58c94c55b7735888d3ebde0c25fc05e4e5335
ARGOCD_REDIS_IMAGE_TAG=8.6.4-alpine@sha256:2cc044fc5a07c9b701f8f1255a309ae9ad7856e694ac03513bf3648c01e40763

# agentgateway and the Gateway API CRDs it needs.
AGW_VERSION=v1.6.0
AGW_CHART_REPO=oci://cr.agentgateway.dev/charts
AGW_CHART_DIGEST=sha256:d3edf2b33cbf2e9d59406c207b8d3554597799707b8803b5f62e698fe5376e28
AGW_CRDS_CHART_DIGEST=sha256:dd7f965d43e54dffa9c95af089b6f762397a23c963a159ad6d4992f6c582292a
GATEWAY_API_VERSION=v1.6.0
GATEWAY_CRDS_URL=https://github.com/kubernetes-sigs/gateway-api/releases/download/$GATEWAY_API_VERSION/standard-install.yaml
GATEWAY_CRDS_FILE_SHA256=a557172e8348f758479e9ee4000bbbb4b4aa48302a6b73461823ea5349bad56d

# The demo MCP server (platform/demo-mcp.yaml) runs on the agent image's node base, by the
# same index digest as agent/Dockerfile's FROM.
NODE_IMAGE=node:24-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205

# The GitHub MCP server for git out (platform/github-mcp.yaml), by index digest.
GITHUB_MCP_IMAGE=ghcr.io/github/github-mcp-server:v2.0.3@sha256:250bc6ce70788207608ef74cef4397230ff2e8481218da74d6093e4bd9101132

# The image make smoke pushes to the local registry.
SMOKE_IMAGE=busybox:1.37.0@sha256:bdf57e528e45e4433820e045b29b4597825a1c9e38353532d90a01445013f82e

# The token caps' backend (platform/ratelimit.yaml): Envoy's ratelimit service (it publishes no
# release tags, so the digest is the pin) and the Redis it counts in (Argo CD's Redis, same digest).
RATELIMIT_IMAGE=docker.io/envoyproxy/ratelimit:master@sha256:3d8af7853a9fad2723b2c07f29dd92d416bdfeed50183cf625b210f5115c7e28
REDIS_IMAGE=docker.io/library/redis:8.6.4-alpine@sha256:2cc044fc5a07c9b701f8f1255a309ae9ad7856e694ac03513bf3648c01e40763
