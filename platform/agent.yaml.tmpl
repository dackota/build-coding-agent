# The hello byo agent. deploy.sh replaces @IMAGE@ with <registry kind-network address>:5000/hello-agent@sha256:<digest>.
# No key lives here: the agent reaches the model through agentgateway via kagent's
# default-model-config, and the gateway holds the key.
apiVersion: api.kagent.dev/v1alpha3
kind: Harness
metadata: {name: hello-harness, namespace: kagent}
spec:
  byo: {}
  workload:
    image: @IMAGE@
    command: ["node", "/app/src/main.ts"]
  substrate:
    workerPoolRef: {name: kagent-default}
    snapshotPolicy:
      location: gs://ate-snapshots/kagent/
---
# The subagents' own models, both through agentgateway like default-model-config:
# a cheap one to explore, a stronger one to execute.
apiVersion: api.kagent.dev/v1alpha3
kind: ModelConfig
metadata: {name: explorer-model-config, namespace: kagent}
spec:
  provider: OpenAI
  model: glm-5.3-flash
  openAI:
    apiFormat: chatCompletions
    baseUrl: http://agentgateway-proxy.agentgateway-system.svc.cluster.local/v1
---
apiVersion: api.kagent.dev/v1alpha3
kind: ModelConfig
metadata: {name: executor-model-config, namespace: kagent}
spec:
  provider: OpenAI
  model: glm-5.1
  openAI:
    apiFormat: chatCompletions
    baseUrl: http://agentgateway-proxy.agentgateway-system.svc.cluster.local/v1
---
apiVersion: api.kagent.dev/v1alpha3
kind: AgentTemplate
metadata: {name: hello-agent, namespace: kagent}
spec:
  description: Hello TypeScript byo agent
  modelConfig: {name: default-model-config}
  # The ambiguity rule for ask_user is not here: the agent adds it (agent/src/system-prompt.ts).
  systemPrompt: |
    You are a concise coding agent. Reply briefly.
    Files the user sends are in your workspace. To change code, read the file first, then use
    edit_file (or write_file for a new file); use search to find where a name is used. Change
    only what the task asks for. The user gets a diff of your changes, so do not repeat the code.
    The task tool hands a job to a subagent that shares your workspace: the explorer only reads
    (cheap), the executor can write. Give each a complete prompt.
  tools:
    # Every call of delete_branch pauses with a tool_approval_request (platform/demo-mcp.yaml).
    - mcp:
        server: {kind: RemoteMCPServer, name: demo-mcp}
        tools: [delete_branch]
        requireApproval: true
    - subAgent:
        name: explorer
        description: Read-only helper that finds and reads files and summarizes them. Cheap and fast.
        templateRef: {name: explorer-template}
    - subAgent:
        name: executor
        description: Does the hard work with full file tools (read, write, edit, search).
        templateRef: {name: executor-template}
---
apiVersion: api.kagent.dev/v1alpha3
kind: AgentTemplate
metadata: {name: explorer-template, namespace: kagent}
spec:
  description: Read-only explorer subagent
  modelConfig: {name: explorer-model-config}
  systemPrompt: You explore the workspace with read_file and search, and answer with what you found. You cannot change files. Be brief.
---
apiVersion: api.kagent.dev/v1alpha3
kind: AgentTemplate
metadata: {name: executor-template, namespace: kagent}
spec:
  description: Executor subagent with full file tools
  modelConfig: {name: executor-model-config}
  systemPrompt: You carry out the job you are given with the file tools (read_file, write_file, edit_file, search). Read a file before editing it. Reply with a one-line summary of what you changed.
---
apiVersion: api.kagent.dev/v1alpha3
kind: Agent
metadata: {name: hello-agent, namespace: kagent}
spec:
  template:
    ref: {name: hello-agent}
  harnessRef: {name: hello-harness}
  # git over HTTPS and the npm registry, by DNS name (platform/egress.yaml).
  egressPolicyRefs: [{name: agent-git-egress}]
