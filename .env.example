# Copy to .env in the main checkout (worktrees share it) and fill in. Never commit .env.
# The OpenCode Go plan key. make up puts it in a Secret for agentgateway only.
OPENCODE_KEY=
# A fine-grained GitHub token for the repos the agent may push to (contents and pull requests:
# read and write). make deploy puts it in a Secret for the GitHub MCP server only.
GITHUB_TOKEN=
